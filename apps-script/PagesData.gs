  "          : 'Updated · ' + d.count + ' recipes';",
  "        setTimeout(showFresh, 2600);",
  "      } else showFresh();",
  "    })",
  "    .catch(e => {",
  "      out.className = 'stamp';",
  "      out.textContent = 'Could not load (' + e + ')';",
  "    })",
  "    .finally(() => { if (manual) btn.disabled = false; });",
  "}",
  "",
  "function showFresh(){",
  "  const out = document.getElementById('freshness');",
  "  out.className = 'stamp';",
  "  out.textContent = DATA.at ? 'Updated ' + ago(DATA.at) : (DATA.generated || '');",
  "}",
  "",
  "document.getElementById('refresh').addEventListener('click', () => load(true));",
  "setInterval(() => { if (!document.hidden) load(false); }, 120000);",
  "setInterval(showFresh, 30000);",
  "load(false);",
  "const $ = id => document.getElementById(id);",
  "const esc = s => String(s == null ? '' : s).replace(/[&<>\"']/g,",
