  "  $('mtitle').className='';",
  "  $('mtitle').textContent=VIEWS[kind].title;",
  "  $('mcount').textContent=rows.length+(rows.length===1?' recipe':' recipes');",
  "  var col=VIEWS[kind].col||COUNTCOL;",
  "  var right=col.wide?'':' class=\"n\" style=\"text-align:right\"';",
  "  $('mbody').innerHTML = rows.length",
  "    ? '<table'+(ROWSTRETCH?' class=\"stretch\"':'')+'><thead><tr><th>Recipe ID</th><th>Name</th><th>Status</th>'+",
  "      '<th'+right+'>'+esc(col.head)+'</th></tr></thead><tbody>'+",
  "      rows.map(function(r){",
  "        return '<tr class=\"rowr\"><td class=\"id\"><button type=\"button\" class=\"rowbtn\" data-rid=\"'+esc(r.id)+",
  "          '\" aria-label=\"Open '+esc(r.id)+' '+esc(r.name)+'\">'+esc(r.id)+'</button></td><td>'+esc(r.name)+",
  "          '</td><td>'+statusCell(r)+'</td><td'+right+'>'+esc(col.cell(r))+'</td></tr>';}).join('')+",
  "      '</tbody></table>'",
  "    : '<p class=\"empty\">Nothing to show.</p>';",
  "}",
  "/* Quantity and its unit read as one value, and either can be blank in the log. */",
  "function qty(i){",
  "  var s=(String(i&&i.q!=null?i.q:'').trim()+' '+String(i&&i.u!=null?i.u:'').trim()).trim();",
  "  return s||'—';",
  "}",
  "function renderDetail(r){",
  "  var ing=r.ing||[];",
  "  $('mback').hidden=false;",
  "  $('mtitle').className='big';",
  "  $('mtitle').textContent=r.name||r.id;",
  "  $('mcount').textContent=ing.length+(ing.length===1?' ingredient':' ingredients');",
  "  $('mbody').innerHTML=",
  "    '<div class=\"meta\"><div><div class=\"k\">Recipe ID</div><div class=\"v id\">'+esc(r.id)+'</div></div>'+",
  "    '<div><div class=\"k\">Status</div><div class=\"v\">'+statusCell(r)+'</div></div>'+",
  "    '<div><div class=\"k\">Created by</div><div class=\"v\">'+esc(r.by||'—')+'</div></div>'+",
  "    '<div><div class=\"k\">Cost / cup</div><div class=\"v\">'+",
  "      (r.cost==null?'—':'RM '+Number(r.cost).toFixed(2))+'</div></div>'+",
  "    '<div><div class=\"k\">Gross margin</div><div class=\"v\">'+",
  "      (r.margin==null?'—':r.margin.toFixed(1)+'%')+'</div></div></div>'+",
  "    /* Why there is no cost, said here rather than left as a dash — this is the",
  "       page the person who can fix it is already looking at. */",
  "    (r.costCheck",
  "      ? '<div class=\"note\"><b>Costs more to make than it sells for.</b> '+esc(r.costCheck.why)+",
  "        (r.costCheck.worst?' The dearest line is <b>'+esc(r.costCheck.worst)+'</b>.':'')+'</div>'",
  "      : (r.costPending",
  "        ? '<div class=\"note\">No cost yet: '+",
  "          [(r.unpriced&&r.unpriced.length?'no price for <b>'+esc(r.unpriced.join(', '))+'</b>':''),",
  "           (r.unmeasured&&r.unmeasured.length?'the quantity for <b>'+esc(r.unmeasured.join(', '))+",
  "             '</b> is not a number':'')].filter(Boolean).join(', and ')+'.</div>'",
  "        : ''))+",
  "    '<h4>Ingredients</h4>'+",
  "    (ing.length",
  "      ? '<table><thead><tr><th>Ingredient</th><th class=\"n\" style=\"text-align:right\">Quantity</th></tr></thead><tbody>'+",
  "        ing.map(function(i){return '<tr><td>'+esc(i.n)+'</td><td class=\"n\">'+esc(qty(i))+'</td></tr>';}).join('')+",
  "        '</tbody></table>'",
  "      : '<p class=\"empty\">No ingredients recorded.</p>');",
  "}",
  "function rowButton(id){",
  "  var bs=$('mbody').getElementsByClassName('rowbtn');",
  "  for(var i=0;i<bs.length;i++){ if(bs[i].getAttribute('data-rid')===String(id)) return bs[i]; }",
  "  return null;",
  "}",
  "function focusQuietly(el){",
  "  if(!el||!el.focus) return;",
  "  try{ el.focus({preventScroll:true}); }catch(err){ el.focus(); }",
  "}",
  "/* One paint for whichever view is up, so the 60-second refresh never throws",
  "   away the list you are reading or the recipe you opened. */",
  "function paint(){",
  "  var r=DETAIL?findRecipe(DETAIL):null;",
  "  if(DETAIL&&!r) DETAIL=null;",
  "  if(r) renderDetail(r); else renderList(OPEN);",
  "}",
  "function openModal(kind){",
  "  if(!VIEWS[kind]||!ALL) return;",
  "  BACKTO=document.activeElement;",
  "  OPEN=kind; DETAIL=null; LISTSCROLL=0;",
  "  renderList(kind);",
  "  $('modal').hidden=false;",
  "  $('mbody').scrollTop=0;",
  "  document.body.style.overflow='hidden';",
  "  $('mclose').focus();",
  "}",
  "function showDetail(id){",
  "  var r=findRecipe(id);",
  "  if(!r) return;",
  "  LISTSCROLL=$('mbody').scrollTop;",
  "  DETAIL=String(id);",
  "  renderDetail(r);",
  "  $('mbody').scrollTop=0;",
  "  $('mback').focus();",
  "}",
  "/* Back returns to the same filter, the same scroll position, and the row you",
  "   left from. */",
  "function showList(){",
  "  var from=DETAIL;",
  "  DETAIL=null;",
  "  renderList(OPEN);",
  "  $('mbody').scrollTop=LISTSCROLL;",
  "  focusQuietly((from&&rowButton(from))||$('mclose'));",
  "}",
  "function closeModal(){",
  "  if(!OPEN) return;",
  "  OPEN=null; DETAIL=null; LISTSCROLL=0;",
  "  $('modal').hidden=true;",
  "  $('mbody').innerHTML='';",
  "  document.body.style.overflow='';",
  "  if(BACKTO&&BACKTO.focus) BACKTO.focus();",
  "  BACKTO=null;",
  "}",
  "function up(el,attr){",
  "  while(el&&el!==document){ if(el.getAttribute&&el.getAttribute(attr)!=null) return el; el=el.parentNode; }",
  "  return null;",
  "}",
  "function barRow(label,n,max){",
  "  var pct = max>0 ? Math.round(n/max*100) : 0;",
  "  return '<tr><td>'+esc(label)+'</td>'+",
  "    '<td style=\"width:45%\"><div class=\"bar\"><span style=\"width:'+pct+'%\"></span></div></td>'+",
  "    '<td class=\"n\">'+n+'</td></tr>';",
  "}",
  "",
  "function draw(d){",
  "  $('sub').textContent = dmy(d.today)+' · '+d.library.total+' creations in the log';",
  "  $('live').textContent = 'updated '+ago(d.at);",
  "",
  "  $('banner').innerHTML = d.trialRows===0",
  "    ? '<div class=\"note\"><b>Trial activity is empty.</b> Everything below the library counts reads '+",
  "      'from <b>R&amp;D TRIAL LOG</b>, which has no rows yet — so today, pipeline and status all show zero. '+",
  "      'They fill in on their own as R&amp;D submits through the intake form.</div>'",
  "    : '';",
  "",
  "  var L=d.library;",
  "  /* A tile only becomes a button when there is something behind it to show. */",
  "  var can=!!(ALL&&ALL.recipes);",
  "  function act(kind,n){ return (can&&n>0)?{filter:kind}:null; }",
  "  $('lib').innerHTML =",
  "    tile('Total creations', L.total, '', '', act('all',L.total)) +",
  "    tile('Approved', L.approved, Math.round(L.approved/Math.max(L.total,1)*100)+'% of library','good', act('approved',L.approved)) +",
  "    tile('Pending review', L.pendingReview, L.pendingReview?'waiting on you':'nothing waiting', L.pendingReview?'warn':'', L.pendingReview>0?{href:'approve.html'}:null) +",
  "    tile('Unreviewed', L.unreviewed, 'never assessed', '', act('unreviewed',L.unreviewed)) +",
  "    tile('Rejected', L.rejected, '', '', act('rejected',L.rejected)) +",
  "    /* Both halves open now that there is something behind them: the costed",
  "       recipes with their margins, and the ones still waiting with the reason",
  "       against each. Below the tiles, the ingredients holding the most recipes",
  "       up — which is the order to work the price list in. */",
  "    tile('Costing done', L.costingDone, L.costingPending+' still pending',",
  "         L.costingDone?'good':'warn', act('costed',L.costingDone)) +",
  "    tile('Needs costing', L.costingPending, L.costingPending?'no cost per cup yet':'all costed',",
  "         L.costingPending?'warn':'good', act('costing',L.costingPending));",
  "",
  "  var B=d.costingBlockers||[];",
  "  $('blockers').innerHTML = B.length",
  "    ? '<table><tr><th>Ingredient</th><th>Why</th>'+",
  "      '<th class=\"n\" style=\"text-align:right\">Recipes</th></tr>'+",
  "      B.slice(0,12).map(function(b){",
  "        return '<tr><td>'+esc(b.name)+'</td><td>'+esc(b.reason)+'</td>'+",
  "          '<td class=\"n\">'+b.recipes+'</td></tr>';}).join('')+'</table>'+",
  "      (B.length>12?'<p class=\"empty\">'+(B.length-12)+' more.</p>':'')",
  "    : '<p class=\"empty\">Every ingredient in the library has a price. Nothing is holding costing up.</p>';",
  "",
  "  var T=d.todayCounts;",
  "  $('today').innerHTML =",
  "    tile('New drinks', T.created) + tile('Trials done', T.trials) +",
  "    tile('Approved', T.approved, '', T.approved?'good':'') +",
  "    tile('Failed', T.failed, '', T.failed?'crit':'') +",
  "    tile('Revision', T.revision, '', T.revision?'warn':'');",
  "",
  "  var A=d.accumulated;",
  "  $('accum').innerHTML='<table><tr><th>Period</th><th class=\"n\" style=\"text-align:right\">New drinks</th>'+",
  "    '<th class=\"n\" style=\"text-align:right\">Trials</th></tr>'+",
  "    [['Today',A.today],['This week',A.week],['This month',A.month],[d.today.slice(0,4)+' to date',A.year]]",
  "      .map(function(x){return '<tr><td>'+x[0]+'</td><td class=\"n\">'+x[1].drinks+'</td><td class=\"n\">'+x[1].trials+'</td></tr>';})",
  "      .join('')+'</table>';",
  "",
  "  var P=d.pics, names=Object.keys(P);",
  "  $('pics').innerHTML='<table><tr><th>Person</th><th class=\"n\" style=\"text-align:right\">New drinks</th>'+",
  "    '<th class=\"n\" style=\"text-align:right\">Trials</th><th class=\"n\" style=\"text-align:right\">This month</th></tr>'+",
  "    names.map(function(n){return '<tr><td>'+esc(n)+'</td><td class=\"n\">'+P[n].drinks+'</td>'+",
  "      '<td class=\"n\">'+P[n].trials+'</td><td class=\"n\">'+P[n].monthTrials+'</td></tr>';}).join('')+",
  "    '<tr><td><b>Total</b></td><td class=\"n\"><b>'+names.reduce(function(a,n){return a+P[n].drinks;},0)+",
  "    '</b></td><td class=\"n\"><b>'+names.reduce(function(a,n){return a+P[n].trials;},0)+",
  "    '</b></td><td class=\"n\"><b>'+names.reduce(function(a,n){return a+P[n].monthTrials;},0)+'</b></td></tr></table>';",
  "",
  "  var mx=Math.max.apply(null,d.pipeline.map(function(s){return s.n;}).concat([0]));",
  "  $('pipe').innerHTML = mx===0",
  "    ? '<p class=\"empty\">No trials recorded yet.</p>'",
  "    : '<table>'+d.pipeline.map(function(s){return barRow(s.stage,s.n,mx);}).join('')+'</table>';",
  "",
  "  var S=d.status;",
  "  var st=[['In R&D',S.inRnD,''],['Waiting',S.waiting,''],['Revision',S.revision,''],",
  "          ['Pending review',S.pending,S.pending?'warn':''],['Completed',S.completed,''],",
  "          ['Overdue',S.overdue,S.overdue?'crit':'']];",
  "  var smx=Math.max.apply(null,st.map(function(x){return x[1];}).concat([0]));",
  "  $('stat').innerHTML = smx===0",
  "    ? '<p class=\"empty\">No trials recorded yet.</p>'",
  "    : '<table>'+st.map(function(x){",
  "        return '<tr><td>'+x[0]+(x[2]?' <span class=\"pill '+x[2]+'\">'+(x[2]==='crit'?'overdue':'waiting')+'</span>':'')+",
  "          '</td><td style=\"width:40%\"><div class=\"bar\"><span style=\"width:'+",
  "          (smx?Math.round(x[1]/smx*100):0)+'%\"></span></div></td><td class=\"n\">'+x[1]+'</td></tr>';}).join('')+'</table>';",
  "",
  "  var V=d.versions;",
  "  $('ver').innerHTML =",
  "    tile('Recipes with &gt;1 version', V.multiVersion) +",
  "    tile('Major updates this month', V.majorThisMonth) +",
  "    tile('Minor updates this month', V.minorThisMonth);",
  "",
  "  $('pcount').innerHTML = d.pendingApproval.length",
  "    ? '<span class=\"pill warn\">'+d.pendingApproval.length+'</span>' : '<span class=\"pill ok\">clear</span>';",
  "  $('pend').innerHTML = d.pendingApproval.length",
  "    ? '<table><tr><th>Recipe</th><th>Version</th><th>By</th><th>Submitted</th></tr>'+",
  "      d.pendingApproval.map(function(p){",
  "        return '<tr class=\"lnk\" data-href=\"approve.html\"><td class=\"id\"><a href=\"approve.html\">'+esc(p.id)+",
  "          '</a></td><td>'+esc(p.ver)+'</td><td>'+esc(p.pic)+",
  "          '</td><td>'+dmy(p.date)+'</td></tr>';}).join('')+'</table>'+",
  "      '<p style=\"margin:11px 0 0\"><a class=\"btn\" href=\"approve.html\">Review them →</a></p>'",
  "    : '<p class=\"empty\">Nothing waiting for approval.</p>';",
  "",
  "  $('ocount').innerHTML = d.overdue.length",
  "    ? '<span class=\"pill crit\">'+d.overdue.length+'</span>' : '<span class=\"pill ok\">clear</span>';",
  "  $('over').innerHTML = d.overdue.length",
  "    ? '<table><tr><th>Recipe</th><th>Owner</th><th class=\"n\" style=\"text-align:right\">Days over</th></tr>'+",
  "      d.overdue.map(function(o){",
  "        return '<tr><td class=\"id\">'+esc(o.id)+'</td><td>'+esc(o.pic||'—')+",
  "          '</td><td class=\"n\">'+o.days+'</td></tr>';}).join('')+'</table>'",
  "    : '<p class=\"empty\">Nothing overdue.</p>';",
  "",
  "  $('latest').innerHTML = d.latest.length",
  "    ? '<table><tr><th>Recipe</th><th>Name</th><th>Version</th><th>PIC</th><th>Status</th><th>Date</th></tr>'+",
  "      d.latest.map(function(t){",
  "        return '<tr><td class=\"id\">'+esc(t.id)+'</td><td>'+esc(t.name)+'</td><td>'+esc(t.ver)+",
  "          '</td><td>'+esc(t.pic)+'</td><td>'+esc(t.status)+'</td><td>'+dmy(t.date)+'</td></tr>';}).join('')+'</table>'",
  "    : '<p class=\"empty\">No trials recorded yet.</p>';",
  "}",
  "",
  "function pull(){",
  "  return Promise.all([",
  "    fetch('dashboard.json?t='+Date.now(),{cache:'no-store'})",
  "      .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); }),",
  "    fetch('all-recipes.json?t='+Date.now(),{cache:'no-store'})",
  "      .then(function(r){ return r.ok?r.json():null; })",
  "      .catch(function(){ return null; })",
  "  ]).then(function(res){",
  "    if(res[1]&&res[1].recipes) ALL=res[1];",
  "    draw(res[0]);",
  "    if(OPEN){ var sc=$('mbody').scrollTop; paint(); $('mbody').scrollTop=sc; }",
  "  }).catch(function(){ $('live').textContent='could not reach the data'; });",
  "}",
  "",
  "$('lib').addEventListener('click',function(e){",
  "  var b=up(e.target,'data-filter');",
  "  if(b) openModal(b.getAttribute('data-filter'));",
  "});",
  "$('pend').addEventListener('click',function(e){",
  "  var tr=up(e.target,'data-href');",
  "  if(tr&&e.target.tagName!=='A') GC_GO(tr.getAttribute('data-href'));",
  "});",
  "$('modal').addEventListener('click',function(e){",
  "  var r=up(e.target,'data-rid');",
  "  if(r){ showDetail(r.getAttribute('data-rid')); return; }",
  "  if(up(e.target,'data-back')){ showList(); return; }",
  "  if(up(e.target,'data-close')) closeModal();",
  "});",
  "document.addEventListener('keydown',function(e){",
  "  if(OPEN&&(e.key==='Escape'||e.key==='Esc')) closeModal();",
  "});",
  "",
  "pull();",
  "setInterval(pull,60000);",
  "document.addEventListener('visibilitychange',function(){",
  "  if(document.visibilityState==='visible') pull();});",
  "</script>",
  "</body></html>",
  ""
].join('\n');

var PAGE_DATA = {
  "index.html": PAGE_INDEX_HTML,
  "intake.html": PAGE_INTAKE_HTML,
  "approve.html": PAGE_APPROVE_HTML,
  "dashboard.html": PAGE_DASHBOARD_HTML
};
