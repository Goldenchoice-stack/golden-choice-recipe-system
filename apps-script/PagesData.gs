  "              <option>Matcha &amp; Green Tea</option><option>Coffee</option><option>Fruit Tea</option>",
  "              <option>Milk Tea</option><option>Coconut</option><option>Sparkling / Soda</option>",
  "              <option>Cheese Cap / Topping</option><option>Cream / Jam / Jelly (component)</option>",
  "              <option>Dessert / Mooncake</option><option>Snow Ice / Bingsu</option><option>SOP / Standard</option>",
  "            </select></div>",
  "          <div class=\"f\"><label for=\"rproj\">Project</label>",
  "            <select id=\"rproj\"><option>House</option><option>CNY</option><option>Raya</option>",
  "              <option>Christmas</option><option>Valentine</option><option>Ramadan</option>",
  "              <option>Agent Recipe</option><option>Customer Request</option></select>",
  "            <span class=\"hint\">Campaign goes here, never in Status.</span></div>",
  "        </div>",
  "        <div class=\"grid\">",
  "          <div class=\"f\"><label for=\"rbev\">Beverage type</label>",
  "            <select id=\"rbev\"><option>Iced</option><option>Hot</option><option>Blended / Smoothie</option>",
  "              <option>Sparkling</option><option>Nitrogen</option><option>Dessert</option>",
  "              <option>Base / Component</option></select></div>",
  "          <div class=\"f\"><label for=\"rtarget\">Target product</label>",
  "            <input id=\"rtarget\" autocomplete=\"off\" placeholder=\"e.g. BrevA Pistachio Sauce\">",
  "            <span class=\"hint\">The product this trial is meant to sell.</span></div>",
  "        </div>",
  "      </div></div>",
  "",
  "      <div class=\"card\"><h2>2 — Ingredients <span class=\"n\" id=\"ingcount\"></span></h2><div class=\"body\">",
  "        <div class=\"ings\" id=\"ings\"></div>",
  "        <div class=\"row\"><button class=\"btn\" id=\"addIng\">+ Add ingredient</button></div>",
  "        <span class=\"hint\">Type to match an existing name so spellings stay consistent.",
  "          The figure on the right is that line's cost.</span>",
  "      </div></div>",
  "",
  "      <div class=\"card\"><h2>3 — How did the trial go?</h2><div class=\"body\">",
  "        <div class=\"grid\">",
  "          <div class=\"f\"><label for=\"rstage\">Stage</label>",
  "            <select id=\"rstage\"><option>Request</option><option>R&amp;D</option>",
  "              <option selected>Trial</option><option>Revision</option><option>Testing</option></select></div>",
  "          <div class=\"f\"><label for=\"rstatus\">Status</label>",
  "            <select id=\"rstatus\"><option selected>In R&amp;D</option><option>Waiting</option>",
  "              <option>Revision</option><option>Completed</option></select></div>",
  "          <div class=\"f\"><label for=\"rresult\">Trial result</label>",
  "            <select id=\"rresult\"><option value=\"\">— not decided —</option>",
  "              <option>Pass</option><option>Fail</option><option>Revise</option></select></div>",
  "        </div>",
  "        <div class=\"grid\">",
  "          <div class=\"f\"><label for=\"rdue\">Due date</label><input id=\"rdue\" type=\"date\">",
  "            <span class=\"hint\">Leave blank if nothing is promised.</span></div>",
  "          <div class=\"f\"><label for=\"rdone\">Completion date</label><input id=\"rdone\" type=\"date\">",
  "            <span class=\"hint\">Fill only when finished.</span></div>",
  "        </div>",
  "        <div class=\"f\"><label for=\"rnext\">Next action</label>",
  "          <input id=\"rnext\" autocomplete=\"off\" placeholder=\"e.g. Send sample to BA / reduce sweetness\"></div>",
  "        <div class=\"f\"><label for=\"notes\">Notes &amp; customer feedback</label>",
  "          <textarea id=\"notes\" placeholder=\"Anything management should know.\"></textarea></div>",
  "      </div></div>",
  "",
  "      <div class=\"card\"><h2>4 — Production detail</h2><div class=\"body\">",
  "        <div class=\"panel ok\"><b>Cost is not typed here.</b> It is calculated from the quantity you",
  "          use and the pack price from AutoCount, so it cannot go stale or be guessed. Serving size",
  "          and selling price are yours to set.</div>",
  "        <div class=\"grid\">",
  "          <div class=\"f\"><label for=\"serve\">Serving size (ml)</label><input id=\"serve\" type=\"number\" min=\"0\" placeholder=\"480\"></div>",
  "          <div class=\"f\"><label for=\"diff\">Difficulty</label>",
  "            <select id=\"diff\"><option value=\"\">—</option><option>Easy</option><option>Medium</option><option>Advanced</option></select></div>",
  "          <div class=\"f\"><label for=\"price\">Selling price (RM)</label><input id=\"price\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"13.90\"></div>",
  "        </div>",
  "        <div class=\"f\"><label for=\"equip\">Equipment</label>",
  "          <input id=\"equip\" autocomplete=\"off\" placeholder=\"e.g. Espresso machine, blender, whisk\"></div>",
  "        <div class=\"f\"><label for=\"method\">Preparation method</label>",
  "          <textarea id=\"method\" placeholder=\"1. Whisk matcha with warm water until smooth.&#10;2. Add tea base and pear syrup.\"></textarea></div>",
  "      </div></div>",
  "",
  "      <div class=\"card\"><h2>5 — Photo &amp; video</h2><div class=\"body\">",
  "        <div class=\"f\"><label for=\"photo\">Photo of the finished drink</label>",
  "          <input id=\"photo\" type=\"file\" accept=\"image/*\">",
  "          <span class=\"hint\">Saved against the Recipe ID.</span></div>",
  "        <div id=\"photoOut\" hidden><img class=\"thumb\" id=\"thumb\" alt=\"Preview\"></div>",
  "        <div class=\"f\"><label for=\"rvideo\">Recipe video link</label>",
  "          <input id=\"rvideo\" autocomplete=\"off\" placeholder=\"Paste a Drive or YouTube link\"></div>",
  "      </div></div>",
  "",
  "      <div class=\"card\" id=\"cardUpd\" hidden><h2>6 — Why is this being changed?</h2><div class=\"body\">",
  "        <div class=\"f\"><label for=\"reason\">Reason for update <span class=\"req\">*</span></label>",
  "          <select id=\"reason\"><option value=\"\">— choose —</option>",
  "            <option>Ingredient Change</option><option>Quantity Adjustment</option>",
  "            <option>Preparation Method</option><option>Product Replacement</option>",
  "            <option>Cost Adjustment</option><option>Customer Feedback</option>",
  "            <option>Internal R&amp;D Improvement</option><option>Typo / Formatting</option><option>Other</option>",
  "          </select></div>",
  "        <div class=\"f\"><label for=\"remarks\">Update remarks <span class=\"req\">*</span></label>",
  "          <textarea id=\"remarks\" placeholder=\"e.g. Reduced syrup from 20ml to 15ml after internal tasting.\"></textarea></div>",
  "      </div></div>",
  "    </div>",
  "",
  "    <!-- right column -->",
  "    <div class=\"sticky\">",
  "      <div class=\"card\"><h2>Version</h2><div class=\"body\"><div id=\"verBox\"></div></div></div>",
  "      <div class=\"card\"><h2>Costing <span class=\"n\" id=\"costBadge\"></span></h2>",
  "        <div class=\"body\"><div id=\"costWrap\"></div><span class=\"hint\" id=\"costHint\"></span></div></div>",
  "      <div class=\"card\" id=\"chgCard\" hidden><h2>What changed</h2><div class=\"body\"><div id=\"chgBox\"></div></div></div>",
  "      <div class=\"card\"><h2>Checks</h2><div class=\"body\"><div class=\"chk\" id=\"checks\"></div></div></div>",
  "      <div class=\"card\"><h2>Submit</h2><div class=\"body\">",
  "        <div class=\"panel warn\">Submitted as <b>PENDING REVIEW</b>. R&amp;D cannot approve its own",
  "          recipe — only the owner does that, on the Approvals page.</div>",
  "        <div class=\"row\">",
  "          <button class=\"btn pri\" id=\"submit\">Submit</button>",
  "          <button class=\"btn\" id=\"backB\">← Start over</button>",
  "          <span class=\"hint\" id=\"msg\"></span>",
  "        </div>",
  "      </div></div>",
  "    </div>",
  "  </div>",
  "</section>",
  "",
  "<!-- ===== 4. done ===== -->",
  "<section id=\"scDone\" hidden><div class=\"card\"><div class=\"body\" id=\"doneBody\"></div></div></section>",
  "",
  "<footer>",
  "  Recipe IDs are permanent. Versions record every revision. Nothing is overwritten — an approved",
  "  recipe stays current until its replacement is approved.",
  "</footer>",
  "</div>",
  "",
  "<script>",
  "'use strict';",
  "var $=function(i){return document.getElementById(i);};",
  "var DATA=null, PRICES=null, MODE=null, CUR=null, photoData=null;",
  "",
  "function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){",
  "  return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}",
  "function round2(n){return Math.round(Number(n)*100+1e-9)/100;}",
  "function rm(n){return 'RM'+round2(n).toFixed(2);}",
  "function todayISO(){var d=new Date(),p=function(x){return(x<10?'0':'')+x;};",
  "  return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate());}",
  "",
  "/* ---------- live data ---------- */",
  "var POLL_MS=60000;",
  "function banner(h){var b=$('liveBanner');",
  "  if(!h){b.hidden=true;b.style.display='none';return;}",
  "  b.innerHTML=h;b.hidden=false;b.style.display='block';}",
  "function sig(r){return JSON.stringify([r.name,r.status,(r.ing||[]).map(function(i){return[i.n,i.q,i.u];})]);}",
  "",
  "function applyData(d,first){",
  "  var prevNext=DATA?DATA.nextId:null;",
  "  DATA=d;",
  "  $('sub').textContent=d.count+' creations · '+d.counts.approved+' approved · next new ID '+d.nextId;",
  "  var dl=$('ingList');",
  "  if(dl) dl.innerHTML=d.ingredients.map(function(n){return '<option value=\"'+esc(n)+'\">';}).join('');",
  "  if(first) return;",
  "  if(MODE==='new'&&prevNext&&d.nextId!==prevNext){",
  "    setBadge(d.nextId,'New creation');",
  "    banner('A recipe was just added to the sheet, so this will now be saved as <b>'+d.nextId+'</b> instead of '+prevNext+'.');",
  "  }",
  "  if(MODE==='update'&&CUR){",
  "    var now=d.recipes.find(function(r){return r.id===CUR.id;});",
  "    if(now&&sig(now)!==sig(CUR)){",
  "      banner('<b>'+CUR.id+'</b> was changed in the Google Sheet while you were editing. '+",
  "        'The change list below is against the older version. '+",
  "        '<button class=\"btn sm\" id=\"reloadRec\" style=\"margin-left:8px\">Reload current recipe</button>');",
  "      var rb=$('reloadRec');",
  "      if(rb) rb.addEventListener('click',function(){banner('');loadRecipe(now);});",
  "    }",
  "  }",
  "}",
  "function pull(first){",
  "  return fetch('all-recipes.json?t='+Date.now(),{cache:'no-store'})",
  "    .then(function(r){return r.json();}).then(function(d){applyData(d,first);})",
  "    .catch(function(){ if(first) $('sub').textContent='Could not load recipe data. Refresh shortly.'; });",
  "}",
  "fetch('prices.json?t='+Date.now(),{cache:'no-store'}).then(function(r){return r.json();})",
  "  .then(function(p){PRICES=p;render();}).catch(function(){PRICES={items:{}};});",
  "pull(true).then(function(){",
  "  /* Arrived from a card on the Finder: open that recipe straight into the",
  "     update form, so nobody searches for what they just had on screen. */",
  "  var want=(window.GC_PARAMS||{}).update;",
  "  if(!want) return;",
  "  var r=DATA&&DATA.recipes.find(function(x){return x.id===want;});",
  "  if(r) loadRecipe(r);",
  "  else banner('Could not open <b>'+esc(want)+'</b> - search for it below.');",
  "});",
  "setInterval(function(){pull(false);},POLL_MS);",
  "document.addEventListener('visibilitychange',function(){",
  "  if(document.visibilityState==='visible') pull(false);});",
  "",
  "/* ---------- screens ---------- */",
  "function show(id){['scChoose','scSearch','scForm','scDone'].forEach(function(s){$(s).hidden=(s!==id);});",
  "  window.scrollTo({top:0,behavior:'instant'});}",
  "function setBadge(id,sub){var b=$('badge');b.hidden=false;b.firstChild.nodeValue=id;$('badgeSub').textContent=sub;}",
  "",
  "function resetForm(){",
  "  ['rname','rzh','rtarget','rnext','notes','equip','method','serve','price','rvideo','remarks'].forEach(function(i){$(i).value='';});",
  "  ['rcat','rby','reason','rresult','diff'].forEach(function(i){$(i).value='';});",
  "  $('rdate').value=todayISO(); $('rdue').value=''; $('rdone').value='';",
  "  $('rstage').value='Trial'; $('rstatus').value='In R&D'; $('rproj').value='House'; $('rbev').value='Iced';",
  "  $('photo').value=''; $('photoOut').hidden=true; photoData=null;",
  "  $('ings').innerHTML='';",
  "  /* Signed in under an R&D name: it is their trial nine times in ten, so the",
  "     field starts on their name rather than on choose. Still changeable. */",
  "  if(window.GC_USER&&window.GC_USER.pic) $('rby').value=window.GC_USER.pic;",
  "}",
  "$('goNew').addEventListener('click',function(){",
  "  if(!DATA) return; banner(''); MODE='new'; CUR=null;",
  "  setBadge(DATA.nextId,'New creation'); $('cardUpd').hidden=true; $('chgCard').hidden=true;",
  "  resetForm(); addRow(); addRow();",
  "  $('ctx').className='panel ok';",
  "  $('ctx').innerHTML='<b>New creation.</b> Saved as <b>'+DATA.nextId+'</b> at <b>V1.0</b>, status <b>PENDING REVIEW</b>.';",
  "  render(); show('scForm');",
  "});",
  "$('goUpd').addEventListener('click',function(){",
  "  if(!DATA) return; banner(''); MODE='update'; CUR=null;",
  "  $('badge').hidden=true; $('q').value=''; $('pick').innerHTML=''; $('sug').style.display='none';",
  "  $('qhint').textContent='Searches '+DATA.count+' creations by ID, English or Chinese name, or ingredient.';",
  "  show('scSearch'); $('q').focus();",
  "});",
  "$('backA').addEventListener('click',function(){$('badge').hidden=true;show('scChoose');});",
  "$('backB').addEventListener('click',function(){$('badge').hidden=true;banner('');show('scChoose');});",
  "",
  "/* ---------- search ---------- */",
  "$('q').addEventListener('input',function(){",
  "  var t=this.value.trim().toLowerCase(), s=$('sug');",
  "  if(!t||!DATA){s.style.display='none';return;}",
  "  var out=[];",
  "  for(var i=0;i<DATA.recipes.length&&out.length<40;i++){",
  "    var r=DATA.recipes[i], why='';",
  "    if(r.id.toLowerCase().indexOf(t)>=0) why='id';",
  "    else if(r.name.toLowerCase().indexOf(t)>=0) why='name';",
  "    else if(String(r.zh||'').toLowerCase().indexOf(t)>=0) why='Chinese name';",
  "    else if(r.ing.some(function(x){return x.n.toLowerCase().indexOf(t)>=0;})) why='ingredient';",
  "    if(why) out.push({r:r,why:why});",
  "  }",
  "  if(!out.length){",
  "    s.innerHTML='<div class=\"none\">Nothing among the '+DATA.count+' creations matches <b>'+esc(this.value.trim())+",
  "      '</b>.<br>Try part of the drink name, its Chinese name, an ingredient, or the RCP- number.</div>';",
  "    s.style.display='block';return;}",
  "  /* The count is shown because a list that is merely short looks the same as a",
  "     list that has been cut off, and the difference matters when a recipe seems",
  "     to be missing. */",
  "  s.innerHTML='<div class=\"count\">'+out.length+(out.length>=40?'+ (showing the first 40)':'')+",
  "      ' match'+(out.length===1?'':'es')+'</div>'+",
  "    out.map(function(x){",
  "    return '<div data-id=\"'+x.r.id+'\"><span class=\"id\">'+x.r.id+'</span> — '+esc(x.r.name)+",
  "      (x.r.zh?' <span class=\"zh\">'+esc(x.r.zh)+'</span>':'')+",
  "      ' <span class=\"hint\">· '+x.r.status+' · '+x.r.ing.length+' ingredients'+",
  "      (x.why==='ingredient'||x.why==='Chinese name'?' · matched '+x.why:'')+'</span></div>';}).join('');",
  "  s.style.display='block';",
  "});",
  "$('sug').addEventListener('click',function(e){",
  "  var d=e.target.closest('div[data-id]'); if(!d) return;",
  "  var r=DATA.recipes.find(function(x){return x.id===d.getAttribute('data-id');});",
  "  if(!r) return;",
  "  $('sug').style.display='none'; $('q').value=r.name+' — '+r.id;",
  "  $('pick').innerHTML='<div class=\"panel ok\"><div class=\"vbar\"><b>'+r.id+'</b> — '+esc(r.name)+'</div>'+",
  "    '<div style=\"margin-top:6px\">Status <b>'+r.status+'</b> · '+r.ing.length+' ingredients · current version <b>V1.0</b></div>'+",
  "    '<div class=\"row\" style=\"margin-top:10px\"><button class=\"btn pri\" id=\"load\">Load this recipe</button></div></div>';",
  "  $('load').addEventListener('click',function(){loadRecipe(r);});",
  "});",
  "document.addEventListener('click',function(e){if(!e.target.closest('.searchwrap'))$('sug').style.display='none';});",
  "",
  "function loadRecipe(r){",
  "  CUR=r; MODE='update'; setBadge(r.id,'Existing drink');",
  "  $('cardUpd').hidden=false; $('chgCard').hidden=false;",
  "  resetForm();",
  "  $('rname').value=r.name;",
  "  /* what this recipe already has, so an edit shows up as an edit */",
  "  $('rzh').value=r.zh||'';       $('serve').value=r.serve||'';   $('price').value=r.price||'';",
  "  $('diff').value=r.diff||'';     $('equip').value=r.equip||'';",
  "  $('method').value=r.method||''; $('rvideo').value=r.video||'';",
  "  r.ing.forEach(function(i){addRow(i.n,i.q,i.u);});",
  "  if(!r.ing.length) addRow();",
  "  $('ctx').className='panel '+(r.status==='Approved'?'warn':'ok');",
  "  $('ctx').innerHTML='<b>'+r.id+' — '+esc(r.name)+'</b><br>The Recipe ID never changes; your amendments create a new version.'+",
  "    (r.status==='Approved'?' Because this is <b>Approved</b>, V1.0 stays the live recipe until your new version is approved.':'');",
  "  render(); show('scForm');",
  "}",
  "",
  "/* ---------- ingredients + costing ---------- */",
  "/* Line cost = quantity used ÷ units per pack × pack price. */",
  "function lineCost(name,qty){",
  "  if(!PRICES||!PRICES.items) return {state:'pending'};",
  "  var e=PRICES.items[String(name||'').trim().toLowerCase()];",
  "  if(!e) return {state:'unknown'};",
  "  if(e.nonCost) return {state:'noncost',cost:0};",
  "  var q=parseFloat(qty);",
  "  if(!e.per||e.cost==null||!isFinite(q)) return {state:'pending',code:e.code};",
  "  return {state:'ok',cost:q/e.per*e.cost,code:e.code};",
  "}",
  "function addRow(n,q,u){",
  "  var d=document.createElement('div'); d.className='ing';",
  "  var opts=(DATA?DATA.uoms:['G','ML']).map(function(x){return '<option>'+x+'</option>';}).join('');",
  "  d.innerHTML='<div><input class=\"nm\" list=\"ingList\" autocomplete=\"off\" placeholder=\"Ingredient name\"></div>'+",
  "    '<input class=\"qt\" type=\"number\" min=\"0\" step=\"0.1\" placeholder=\"Qty\">'+",
  "    '<select class=\"um\">'+opts+'</select>'+",
  "    '<div class=\"lc\">—</div>'+",
  "    '<button class=\"x\" title=\"Remove\" aria-label=\"Remove\">×</button>';",
  "  $('ings').appendChild(d);",
  "  if(n!=null) d.querySelector('.nm').value=n;",
  "  if(q!=null) d.querySelector('.qt').value=q;",
  "  if(u!=null) d.querySelector('.um').value=u;",
  "  d.dataset.orig=(n==null)?'':'1';",
  "  d.querySelector('.x').addEventListener('click',function(){",
  "    if(d.dataset.orig&&MODE==='update') d.classList.toggle('gone'); else d.remove();",
  "    render();});",
  "  d.querySelectorAll('input,select').forEach(function(el){",
  "    el.addEventListener('input',render); el.addEventListener('change',render);});",
  "  return d;",
  "}",
  "$('addIng').addEventListener('click',function(){addRow();render();});",
  "function collect(){",
  "  var out=[];",
  "  $('ings').querySelectorAll('.ing').forEach(function(d){",
  "    if(d.classList.contains('gone')) return;",
  "    var n=d.querySelector('.nm').value.trim(); if(!n) return;",
  "    out.push({n:n,q:d.querySelector('.qt').value.trim(),u:d.querySelector('.um').value});});",
  "  return out;",
  "}",
  "",
  "/* ---------- diff ---------- */",
  "var K=function(s){return String(s||'').trim().toLowerCase();};",
  "function diff(){",
  "  if(MODE!=='update'||!CUR) return [];",
  "  var out=[],now=collect(),o={},n={};",
  "  CUR.ing.forEach(function(i){o[K(i.n)]=i;});",
  "  now.forEach(function(i){n[K(i.n)]=i;});",
  "  if(K(CUR.name)!==K($('rname').value)) out.push({f:'Recipe Name',a:CUR.name,b:$('rname').value.trim(),k:'changed'});",
  "  Object.keys(n).forEach(function(k){",
  "    var ni=n[k],oi=o[k];",
  "    if(!oi){out.push({f:ni.n,a:'',b:ni.q+' '+ni.u,k:'added'});return;}",
  "    if(String(oi.q).trim()!==String(ni.q).trim()||K(oi.u)!==K(ni.u))",
  "      out.push({f:ni.n,a:oi.q+' '+oi.u,b:ni.q+' '+ni.u,k:'changed'});});",
  "  Object.keys(o).forEach(function(k){if(!n[k])out.push({f:o[k].n,a:o[k].q+' '+o[k].u,b:'',k:'removed'});});",
  "  /* Production detail. The intake captures these and R&D TRIAL LOG records them,",
  "     so changing serving size or price alone is a real change -- without this the",
  "     page said \"nothing changed yet\" and would not let the update be submitted. */",
  "  [['rzh','Chinese name','zh'],['serve','Serving size','serve'],['price','Selling price','price'],",
  "   ['diff','Difficulty','diff'],['equip','Equipment','equip'],",
  "   ['method','Preparation method','method'],['rvideo','Video link','video']]",
  "  .forEach(function(f){",
  "    var a=String(CUR[f[2]]||'').trim(), b=$(f[0]).value.trim();",
  "    if(K(a)===K(b)) return;",
  "    out.push({f:f[1],a:a,b:b,k:a?(b?'changed':'removed'):'added'});",
  "  });",
  "  if(photoData) out.push({f:'Photo',a:'',b:'new photo attached',k:'added'});",
  "  return out;",
  "}",
  "",
  "/* ---------- render ---------- */",
  "function render(){",
  "  var ings=collect(), ch=diff();",
  "  $('ingcount').textContent=ings.length+' rows';",
  "",
  "  // per-line cost + totals",
  "  var total=0, pending=0, priced=0;",
  "  $('ings').querySelectorAll('.ing').forEach(function(d){",
  "    var cell=d.querySelector('.lc'); if(!cell) return;",
  "    if(d.classList.contains('gone')){cell.textContent='—';cell.className='lc';return;}",
  "    var n=d.querySelector('.nm').value.trim();",
  "    if(!n){cell.textContent='—';cell.className='lc';return;}",
  "    var r=lineCost(n,d.querySelector('.qt').value);",
  "    if(r.state==='ok'){cell.textContent=rm(r.cost);cell.className='lc ok';total+=r.cost;priced++;}",
